PORT=5000

# PostgreSQL (old names Database_URI / DATABASE_URI still work as fallbacks)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# TLS certificates are verified by default. Options:
#   DB_SSL=disable                    local Postgres without TLS
#   DB_SSL_CA=./supabase-ca.pem       trust a specific CA (Supabase: Project Settings > Database > SSL)
#   DB_SSL_REJECT_UNAUTHORIZED=false  insecure opt-out, not recommended
# DB_SSL_CA=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
# Max login/register/invite-check attempts per IP per 15 minutes
AUTH_RATE_LIMIT=10

# Resend (admin invitation emails)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=KwikQ <onboarding@resend.dev>
APP_URL=http://localhost:5173

# Only for `npm test`: a throwaway database the integration tests may wipe
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kwikq_test
